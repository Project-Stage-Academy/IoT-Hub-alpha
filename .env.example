# IoT Hub Alpha - Environment Configuration

# Copy this file to .env and update values for your local environment
# DO NOT commit .env file to version control

# Django Configuration

# Change True in local .env
DEBUG=False

# SECRET: Generate a secure key for production using:
SECRET_KEY=django-development-key-CHANGE-THIS-IN-PRODUCTION-abc123xyz789

ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local

# Security headers (local defaults)
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Database Configuration (PostgreSQL with TimescaleDB)
# Database connection settings for local development
DB_NAME=iot_hub_alpha_db
DB_USER=postgres
# SECRET: Do not commit the database password to version control.
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_CONNECT_TIMEOUT=10

# Database connection pool settings (optional)
# DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# TimescaleDB Configuration

# Telemetry data retention (in days)
TELEMETRY_RETENTION_DAYS=90

# Celery/Redis
# SECRET: Do not commit the Celery broker URL to version control.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
