# IoT Hub Alpha - Environment Configuration

# Copy this file to .env and update values for your local environment
# DO NOT commit .env file to version control

# Django Configuration

# Change True in local .env
DEBUG=False

# Security headers (local defaults)
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# SECRET: Generate a secure key for production using:
SECRET_KEY=django-development-key-CHANGE-THIS-IN-PRODUCTION-abc123xyz789

ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_ALLOW_SEED_FLUSH=1

# Admin user (superuser)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123

# Operator user (staff)
OPERATOR_USERNAME=operator
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=operator123

# Viewer user (staff)
VIEWER_USERNAME=viewer
VIEWER_EMAIL=viewer@example.com
VIEWER_PASSWORD=viewer123

DEVICE_TELEMETRY_INLINE_LIMIT=10
# Database Configuration (PostgreSQL with TimescaleDB)

# Database connection settings for local development
DB_NAME=iot_hub_alpha_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_CONNECT_TIMEOUT=10

# Database connection pool settings (optional)
# DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# TimescaleDB Configuration

# Telemetry data retention (in days)
TELEMETRY_RETENTION_DAYS=90

# Celery/Redis
# SECRET: Do not commit the Celery broker URL to version control.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Grafana Configuration (Monitoring)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
GF_USERS_ALLOW_SIGN_UP=false

#Rule Processor Configuration
CELERY_RUN_PROCESS_TELEMETRY_TIMER_MINUTES=5
DJANGO_RULE_COOLDOWN_MINUTES=60
CELERY_RULE_BATCH_SIZE=1000

# Webhook delivery
DJANGO_WEBHOOKS_ENABLED=false
DJANGO_WEBHOOK_TIMEOUT_SECONDS=5

#MQTT Adapter Configuration
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TOPIC=telemetry/#
MQTT_USERNAME=testmqtt
MQTT_PASSWORD=testmqtt
MQTT_QOS=1
MQTT_USE_TLS=false
MQTT_CONNECT_TIMEOUT=10

# Telemetry pipeline mode:
# - direct: current direct DB ingestion path (default)
# - kafka: publish into Kafka pipeline
TELEMETRY_PIPELINE_MODE=direct

# Telemetry producer backend:
# - log: logs raw events (safe local default)
# - kafka: publish raw events to Kafka (requires backend support)
# Optional override. If left empty, backend follows TELEMETRY_PIPELINE_MODE:
# - direct -> log
# - kafka -> kafka
TELEMETRY_PRODUCER_BACKEND=

# Kafka app settings (used by backend when TELEMETRY_PIPELINE_MODE=kafka)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=iot-hub-backend
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

KAFKA_TOPIC_TELEMETRY_RAW=telemetry.raw
KAFKA_TOPIC_TELEMETRY_CLEAN=telemetry.clean
KAFKA_TOPIC_TELEMETRY_DLQ=telemetry.dlq
KAFKA_TOPIC_EVENT=event.topic

KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_LINGER_MS=20
KAFKA_PRODUCER_BATCH_SIZE=65536
KAFKA_REQUEST_TIMEOUT_MS=30000
KAFKA_PRODUCER_COMPRESSION_TYPE=none
KAFKA_PUBLISH_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_BASE_MS=100
KAFKA_RETRY_BACKOFF_MAX_MS=2000
KAFKA_RETRY_BACKOFF_JITTER=0.2

# Kafka infra bootstrap topics (used by docker-compose kafka-init service)
KAFKA_TOPICS=telemetry.raw,telemetry.clean,telemetry.dlq,event.topic
